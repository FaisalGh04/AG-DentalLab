// AG Dental Lab — Prisma schema
// PostgreSQL (Supabase). Run `pnpm db:push` or `pnpm db:migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// Single admin (the lab owner). No multi-admin, no doctor accounts.
// ------------------------------------------------------------------
model Admin {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String                   @map("password_hash")
  name                    String?
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  staffManagementSessions StaffManagementSession[]

  @@map("admins")
}

// ------------------------------------------------------------------
// A case's lifecycle is defined by its selected production Collection and the
// ordered Stages within it (see src/lib/production-templates.ts). There is no
// fixed status enum anymore — progress is a stage id within a collection.
// ------------------------------------------------------------------

enum CaseCategory {
  IMPLANT
  C_AND_B
  PRESSABLE_CERAMIC
  VACUUM_FORMER
  SPECIAL_TRAY
  RESIN_MODEL
  EXTERNAL_LABORATORY_SERVICES
  DENTAL_EQUIPMENT
  GYPSUM_MODEL
  FLEX_DENTURE
}

// Editable display metadata for the stable CaseCategory enum. Category keys stay
// immutable so existing PatientCase rows never need rewriting; admins manage the
// bilingual labels and the child case-type options instead.
model CaseCategoryConfig {
  category  CaseCategory @id
  labelEn   String       @map("label_en")
  labelAr   String       @map("label_ar")
  order     Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  caseTypes CaseTypeOption[]

  @@index([order])
  @@map("case_category_configs")
}

// Managed choices for PatientCase.caseType. PatientCase intentionally keeps a
// string snapshot rather than a foreign key: renaming/deactivating an option
// affects future selection only and never rewrites historical cases.
model CaseTypeOption {
  id        String       @id @default(cuid())
  category  CaseCategory
  name      String
  isActive  Boolean      @default(true) @map("is_active")
  order     Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  categoryConfig CaseCategoryConfig @relation(fields: [category], references: [category], onDelete: Restrict, onUpdate: Cascade)

  @@unique([category, name])
  @@index([category, isActive, order])
  @@map("case_type_options")
}

// ------------------------------------------------------------------
// A dental case. Doctors track these by public tracking ID only.
// ------------------------------------------------------------------
model PatientCase {
  id                      String       @id @default(cuid())
  trackingId              String       @unique @map("tracking_id")
  patientFirstName        String       @map("patient_first_name")
  patientLastName         String       @map("patient_last_name")
  // Denormalized lowercased full name for fast, case-insensitive lookup.
  patientFullNameNorm     String       @map("patient_full_name_norm")
  // NAME SNAPSHOT, always the display value — never resolved through doctorId.
  // Renaming a roster doctor must not rewrite what past cases say, the same
  // reasoning that keeps receivedBy a snapshot below.
  doctorName              String       @map("doctor_name")
  // Optional link to the Doctor roster. NULL = a free-text one-off doctor who
  // is not on the roster; such a case can be linked retroactively if that
  // doctor is added later. Only linked cases appear in a doctor's public
  // portal. SetNull on delete: removing a roster entry never touches the case.
  doctorId                String?      @map("doctor_id")
  // WHO LOGGED THE CASE INTO THE SYSTEM at intake (not who handled production).
  // Write-once: set on create, never updatable — receivedBy is absent from
  // caseUpdateSchema and the PATCH route rejects it (see src/lib/validations.ts).
  // Required as of Phase B (20260728140000_received_by_not_null); the pre-existing
  // rows were removed rather than backfilled, so no sentinel reached production.
  receivedBy              String       @map("received_by")
  caseType                String       @map("case_type")
  category                CaseCategory
  // Selected production template (src/lib/production-templates.ts). Both nullable:
  // a case can exist before a collection/stage is chosen.
  collectionId            String?      @map("collection_id")
  currentStageId          String?      @map("current_stage_id")
  // Stage ids hidden for THIS case (excluded from its stepper). Default: none.
  hiddenStageIds          String[]     @default([]) @map("hidden_stage_ids")
  // Derived + persisted whenever collection/stage/hidden changes: true when the
  // current stage is the last VISIBLE stage. Drives archive + dashboard queries.
  isCompleted             Boolean      @default(false) @map("is_completed")
  estimatedCompletionDate DateTime?    @map("estimated_completion_date")
  notes                   String?
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  progress   CaseProgress[]
  images     CaseImage[]
  // Virtual back-relation only — the FK column lives on case_action_logs, so
  // this adds NO column to patient_cases. onDelete: SetNull there keeps the
  // audit trail after a case is deleted.
  actionLogs CaseActionLog[]
  doctor     Doctor?         @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  // Indexes tuned for the two hot paths: public tracking lookup + admin list.
  @@index([patientFullNameNorm])
  @@index([trackingId])
  @@index([isCompleted])
  @@index([createdAt])
  @@index([doctorName])
  // Public doctor portal: one doctor's cases, split active/archive, newest
  // first — this composite covers the whole query in one index.
  @@index([doctorId, isCompleted, createdAt])
  @@map("patient_cases")
}

// ------------------------------------------------------------------
// Ordered production steps for a case. Admin adds/updates freely.
// ------------------------------------------------------------------
model CaseProgress {
  id          String   @id @default(cuid())
  caseId      String   @map("case_id")
  stepTitle   String   @map("step_title")
  description String?
  completed   Boolean  @default(false)
  // Which production stage this step belongs to — a stage id from the case's
  // collection (src/lib/production-templates.ts). Nullable: steps added before a
  // collection/stage was chosen are treated as "General" / unscoped. Mirrors
  // CaseImage.stageId so the case detail + tracker can scope steps per stage.
  stageId     String?  @map("stage_id")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  case PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([caseId, stageId])
  @@map("case_progress")
}

// ------------------------------------------------------------------
// Uploaded case images (stored in R2/S3; only the URL is persisted).
// ------------------------------------------------------------------
model CaseImage {
  id        String   @id @default(cuid())
  caseId    String   @map("case_id")
  // Storage object key. Images are NEVER served by a public bucket URL — the
  // key is signed on demand into a short-lived URL via /api/images/[id] (S-M3).
  key       String
  caption   String?
  // Which production stage this image documents — a stage id from the case's
  // collection (src/lib/production-templates.ts). Nullable: images uploaded
  // before a collection/stage was chosen are treated as "General".
  stageId   String?  @map("stage_id")
  createdAt DateTime @default(now()) @map("created_at")

  case PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([caseId, stageId])
  @@map("case_images")
}

// ------------------------------------------------------------------
// The SINGLE SOURCE OF TRUTH for per-stage Quick-Add step chips. Seeded once
// from production-templates.ts's built-in step lists (see the accompanying
// migration), then fully admin-editable: add / rename (labelEn+labelAr) / delete
// any chip. Collections & Stages themselves stay static in production-templates.ts
// (id/en/ar) — only these Quick-Add step LISTS are DB-backed now.
//
// Scoped to a (collectionId, stageId); a chip is shared by every case using that
// collection+stage. Editing/deleting a chip only changes the suggestion list going
// forward — it never touches CaseProgress rows already logged on real cases.
// ------------------------------------------------------------------
model StageQuickAddStep {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  stageId      String   @map("stage_id")
  labelEn      String   @map("label_en")
  labelAr      String   @map("label_ar")
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Phase 1 (case-group migration): nullable link to the DB-backed CaseStage that
  // (collectionId, stageId) resolves to. Additive — the string columns above stay
  // the source of truth until a later phase re-parents these chips fully.
  caseStageId String?    @map("case_stage_id")
  caseStage   CaseStage? @relation(fields: [caseStageId], references: [id], onDelete: Cascade)

  // One chip per English label within a stage (prevents duplicate chips).
  @@unique([collectionId, stageId, labelEn])
  @@index([collectionId, stageId])
  @@index([caseStageId])
  @@map("stage_quick_add_steps")
}

// ------------------------------------------------------------------
// DB-backed case lifecycle taxonomy (Phase 1 of the case-group migration).
// Replaces the static PRODUCTION_COLLECTIONS in src/lib/production-templates.ts,
// preserving every id so live case data keeps resolving:
//   - a "collection" becomes a CaseStageSet (id = the legacy collection kebab id,
//     which PatientCase.collection_id points at)
//   - a CaseGroup is the new parent (Zirconia C&B, Implant, ...) with a Digital
//     and/or Regular stage-set (independent type axis; <= 1 set per type)
//   - a CaseStage keeps stage_key = the legacy stage id (what current_stage_id,
//     hidden_stage_ids, CaseProgress.stage_id and CaseImage.stage_id resolve to)
// Additive only in Phase 1: seeded to mirror the static config, the app does not
// read these tables yet.
// ------------------------------------------------------------------

enum CaseWorkflowType {
  REGULAR
  DIGITAL
}

model CaseGroup {
  id        String   @id @default(cuid())
  labelEn   String   @map("label_en")
  labelAr   String   @map("label_ar")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stageSets CaseStageSet[]

  @@index([order])
  @@map("case_groups")
}

model CaseStageSet {
  // id has NO @default — seeded with the legacy collection kebab id so that
  // PatientCase.collection_id keeps resolving. Admin-created sets get a cuid.
  id        String           @id
  groupId   String           @map("group_id")
  group     CaseGroup        @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  type      CaseWorkflowType
  labelEn   String           @map("label_en")
  labelAr   String           @map("label_ar")
  order     Int              @default(0)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  stages CaseStage[]

  // A group has at most one Regular and one Digital stage-set.
  @@unique([groupId, type])
  @@index([groupId])
  @@map("case_stage_sets")
}

model CaseStage {
  id         String       @id @default(cuid())
  stageSetId String       @map("stage_set_id")
  stageSet   CaseStageSet @relation(fields: [stageSetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // stage_key = the legacy stage id, unique within its set — what live case data
  // (current_stage_id, hidden_stage_ids, CaseProgress/CaseImage.stage_id) resolves to.
  stageKey   String       @map("stage_key")
  labelEn    String       @map("label_en")
  labelAr    String       @map("label_ar")
  order      Int          @default(0)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  quickAddSteps StageQuickAddStep[]

  @@unique([stageSetId, stageKey])
  @@index([stageSetId, order])
  @@map("case_stages")
}

// ------------------------------------------------------------------
// Public "Our Work" portfolio — an admin-managed showcase for the landing page.
// Deliberately SEPARATE from PatientCase/CaseImage: no patient data, its own
// taxonomy (PortfolioFolder, matching the landing folders), and its images are
// public marketing assets (not the private, signed patient-case images).
// ------------------------------------------------------------------

// DB-backed portfolio folder (Phase C: this replaces the old PortfolioFolder
// enum, which has been dropped). Bilingual display name + free ordering,
// admin-managed. Table stays `portfolio_folders` via @@map.
model PortfolioFolder {
  id        String   @id @default(cuid())
  labelEn   String   @map("label_en")
  labelAr   String   @map("label_ar")
  // Display order across the whole Work section (ascending).
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items PortfolioItem[]

  @@index([order])
  @@map("portfolio_folders")
}

// One showcased case: bilingual copy + a folder + display order, with one or
// more photos.
model PortfolioItem {
  id            String          @id @default(cuid())
  folderId      String          @map("folder_id")
  folder        PortfolioFolder @relation(fields: [folderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  titleEn       String          @map("title_en")
  titleAr       String          @map("title_ar")
  descriptionEn String          @map("description_en")
  descriptionAr String          @map("description_ar")
  // Display order within its folder (ascending). Ties break by createdAt.
  order         Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  images PortfolioImage[]

  @@index([folderId, order])
  @@map("portfolio_items")
}

// A photo belonging to a PortfolioItem.
model PortfolioImage {
  id        String   @id @default(cuid())
  itemId    String   @map("item_id")
  // Storage object key (R2/S3) for admin-uploaded photos. For assets migrated
  // from the original static gallery this holds the existing /public path
  // (e.g. /images/gallery/x.jpeg) until a later phase moves serving to R2.
  key       String
  // Intrinsic pixel size, captured at upload — the zoom lightbox needs the true
  // aspect ratio to lay out non-4:3 photos.
  width     Int
  height    Int
  // Display order within the item (ascending), for multi-photo items.
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  item PortfolioItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, order])
  @@map("portfolio_images")
}

// ==================================================================
// Staff confirmation layer (two-factor gate on case creation + stage
// transitions). This sits ON TOP OF the NextAuth admin login in
// src/auth.ts — it does not replace it. The admin still signs in
// normally; these credentials authorise a specific privileged ACTION.
//
// Threat model: these are short secrets held by lab staff, so the real
// control is server-side throttling + lockout (see src/lib/staff-auth.ts
// and confirmationRatelimit), not the hash cost alone.
// ==================================================================

enum ManagerSecretKind {
  PRIMARY
  BREAK_GLASS
}

enum CaseActionType {
  CASE_CREATED
  STAGE_CHANGED
  COLLECTION_CHANGED
  STAGE_VISIBILITY_CHANGED
  STAFF_CONFIRMATION_ENABLED
  STAFF_CONFIRMATION_DISABLED
  STAFF_MANAGEMENT_ACCESS
  STAFF_CREATED
  STAFF_UPDATED
  STAFF_DEACTIVATED
  STAFF_REACTIVATED
  STAFF_MANAGER_ASSIGNED
  MANAGER_SECRET_UPDATED
}

enum CaseActionOutcome {
  SUCCESS
  CONFIRMATION_FAILED
  LOCKED_OUT
}

// A lab staff member who can perform gated actions. `name` doubles as the
// single source of truth for the "Received By" dropdown — but note that
// PatientCase.receivedBy stores a NAME SNAPSHOT, never a FK, so renaming or
// deactivating someone here can never rewrite who received a past case.
model StaffMember {
  id             String    @id @default(cuid())
  name           String    @unique
  // bcrypt, cost 12 — same as Admin.passwordHash (src/auth.ts).
  //
  // NOT consulted for the manager row (isManager = true): that identity
  // authenticates against ManagerSecret.PRIMARY instead, and src/lib/staff-auth.ts
  // branches BEFORE ever reaching this column. It is still NOT NULL, and is set
  // to a bcrypt hash of 32 random bytes nobody holds, so the column is
  // unusable rather than merely unused — defence in depth if that branch is
  // ever refactored wrongly.
  pinHash        String    @map("pin_hash")
  // The single "Manager" identity. When this staff member performs a gated
  // action they supply ONE code (the manager code) which satisfies both factors
  // — a DELIBERATE, accepted reduction in assurance, documented with its full
  // threat model in docs/staff-auth.md. Every other staff member is unaffected
  // and still requires their own password PLUS the manager code.
  //
  // At most one row may hold this, enforced by a PARTIAL UNIQUE INDEX created in
  // raw SQL by migration 20260805132105_add_manager_single_factor. Prisma cannot
  // express `WHERE is_manager = true`, so that index is invisible here — verified
  // not to be treated as drift on Prisma 6.19, but if a future version ever
  // generates a DROP for it, delete the statement rather than accepting it.
  isManager      Boolean   @default(false) @map("is_manager")
  isActive       Boolean   @default(true) @map("is_active")
  order          Int       @default(0)
  // Lockout counters. Reset to (0, null) on any successful confirmation.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  actions CaseActionLog[]

  @@index([isActive, order])
  @@map("staff_members")
}

// Manager approval codes. Exactly two rows: PRIMARY (day-to-day) and
// BREAK_GLASS (emergency, long random, held by a DIFFERENT person than the
// manager, rotated after every use — see docs/staff-auth.md).
model ManagerSecret {
  id         String            @id @default(cuid())
  kind       ManagerSecretKind @unique
  codeHash   String            @map("code_hash")
  lastUsedAt DateTime?         @map("last_used_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@map("manager_secrets")
}

// Short-lived server-side unlock for the manager-only Staff Management area.
// The browser receives only the random raw token in an HTTP-only cookie; the
// database stores its SHA-256 hash, so a database read cannot replay a session.
model StaffManagementSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  adminId   String   @map("admin_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@index([expiresAt])
  @@map("staff_management_sessions")
}

// Immutable audit trail for every gated action, written in the SAME
// transaction as the mutation so a confirmed action cannot exist without its
// log line. Failures are logged too (never the attempted secret) — that is the
// brute-force signal.
model CaseActionLog {
  id                 String            @id @default(cuid())
  // Nullable: a FAILED creation has no case yet. SetNull on delete so removing
  // a case never erases its history; trackingIdSnapshot keeps it readable.
  caseId             String?           @map("case_id")
  trackingIdSnapshot String?           @map("tracking_id_snapshot")
  action             CaseActionType
  outcome            CaseActionOutcome @default(SUCCESS)

  fromCollectionId  String?  @map("from_collection_id")
  toCollectionId    String?  @map("to_collection_id")
  fromStageId       String?  @map("from_stage_id")
  toStageId         String?  @map("to_stage_id")
  hiddenBefore      String[] @default([]) @map("hidden_before")
  hiddenAfter       String[] @default([]) @map("hidden_after")
  // Captured explicitly because toggleHidden can COMPLETE a case without any
  // currentStageId change — the diff-gate would otherwise look like a no-op.
  isCompletedBefore Boolean? @map("is_completed_before")
  isCompletedAfter  Boolean? @map("is_completed_after")

  // Snapshot the name alongside the FK: renaming or deleting staff must not
  // rewrite who performed a past action.
  staffId            String?  @map("staff_id")
  staffNameSnapshot  String?  @map("staff_name_snapshot")
  usedBreakGlass     Boolean  @default(false) @map("used_break_glass")
  // TRUE when the action was approved through the reduced SINGLE-FACTOR manager
  // path — one code satisfying both factors — rather than a genuine two-person
  // confirmation. Recorded EXPLICITLY, never inferred from staffNameSnapshot:
  // that is a mutable snapshot (the manager has already been renamed once), and
  // inference would silently break if a second manager identity ever existed.
  // Without this column a one-person approval is indistinguishable from a real
  // two-factor one, which would make the trail quietly dishonest.
  singleFactor       Boolean  @default(false) @map("single_factor")
  // TRUE when a sensitive case action ran while the global staff confirmation
  // protection was explicitly disabled. This keeps those actions distinct from
  // legacy/null-staff audit rows without pretending that a person confirmed.
  protectionBypassed Boolean  @default(false) @map("protection_bypassed")
  // Who was signed in to /admin at the time (NextAuth session), so both layers
  // are recorded: the logged-in admin AND the staff member who confirmed.
  adminEmail         String?  @map("admin_email")
  ip                 String?
  createdAt          DateTime @default(now()) @map("created_at")

  case  PatientCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  staff StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([createdAt])
  @@index([outcome, createdAt])
  @@map("case_action_logs")
}

// ==================================================================
// Doctor roster + public doctor portal (Phase 1: schema only).
//
// A doctor is OPTIONAL on a case: PatientCase.doctorName stays a required
// free-text snapshot and remains the display value everywhere, while
// doctorId links the case to a roster entry when there is one. That keeps
// one-off doctors working with no sentinel value, and keeps history stable
// when a roster name is edited.
// ==================================================================

model Doctor {
  id String @id @default(cuid())

  // Stored WITH the "Dr. " prefix, exactly as it should display.
  // Deliberately NOT unique: real rosters do contain two people with the same
  // name, and a constraint would hard-block a legitimate entry. Accidental
  // duplicates are caught in the admin UI instead.
  name String

  // The full PUBLIC code: ag-{letters}{sequence}-{random4}, e.g. ag-mut001-K7P2.
  // This is the only column the portal looks up, hence the unique index.
  //
  // The random suffix is NOT decoration. Without it the code is derivable from
  // the doctor's (public) name plus a 3-digit sequence — a targeted guess would
  // take ~130 attempts. The 4 extra characters from the 32-char unambiguous
  // alphabet raise that by ~1,000,000x while staying short enough to read out
  // over the phone.
  code String @unique

  // The 3 transliterated Latin letters. Auto-suggested from the Arabic name,
  // then admin-editable before saving — transliteration is not deterministic.
  codeLetters String @map("code_letters")

  // Global creation order, 1-based, NEVER reused after a delete: reusing a
  // number would make an older printed/spoken reference resolve to a different
  // doctor. Gaps are correct and expected. Unique so concurrent creates fail
  // loudly on the constraint rather than silently colliding.
  sequence Int @unique

  // Rotation support from day one — retrofitting it after a code leaks is
  // painful. Rotation regenerates ONLY the random suffix, so the recognisable
  // {letters}{sequence} part a doctor has memorised stays stable.
  // Null = never rotated. Superseded codes are deliberately NOT retained: a
  // leaked code you have rotated away from is a liability, not an asset.
  codeRotatedAt DateTime? @map("code_rotated_at")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cases PatientCase[]

  @@index([isActive, sequence])
  @@map("doctors")
}

// Singleton global security configuration. The application always reads/upserts
// the row with id = "global" and fails safe to enabled if it is absent or cannot
// be read. Changing it is itself manager-confirmed and audited.
model AdminSecuritySetting {
  id                       String   @id @default("global")
  staffConfirmationEnabled Boolean  @default(true) @map("staff_confirmation_enabled")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("admin_security_settings")
}
